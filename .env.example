# Agent Observatory settings. Copy to .env and fill in for local use.
# On Vercel, set the same names under Project Settings > Environment Variables.

# --- Required (local and Vercel) ---------------------------------------------

# Bearer token the agents use to send events. Never sent to the browser.
# Generate one with: openssl rand -hex 32
INGEST_TOKEN=

# Password for the dashboard and the read API (8 characters or more).
VIEWER_PASSWORD=

# --- Database ----------------------------------------------------------------

# Local: a SQLite file, relative to the repository root unless absolute.
# Vercel: your Turso database, e.g. libsql://observatory-yourname.turso.io
DATABASE_URL=file:./data/observatory.db

# Vercel only: the Turso database token (turso db tokens create <name>).
DATABASE_AUTH_TOKEN=

# --- Vercel only -------------------------------------------------------------

# Vercel Cron sends this as a bearer token to the daily cleanup route. With it
# unset the cleanup route stays closed. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional. Signs the login cookie. Defaults to a value derived from
# VIEWER_PASSWORD; set it to log everyone out by changing it.
SESSION_SECRET=

# --- Local dev server only (ignored on Vercel) -------------------------------

# Address and port `pnpm dev` listens on. Default is this machine only.
# To open it from another device on your network, set BIND_ADDRESS to this
# machine's private address (Tailscale 100.x.y.z or home Wi-Fi). Not 0.0.0.0.
BIND_ADDRESS=127.0.0.1
WEB_PORT=4318

# --- Behaviour ---------------------------------------------------------------

# Events older than this many days are deleted (daily on Vercel, at start locally).
EVENT_RETENTION_DAYS=30

# Optional. Extra folders (comma separated, absolute) whose file paths may be
# stored. A session's own project folder is always allowed.
PROJECT_ROOTS=

# Optional. Largest accepted ingest request in kilobytes. Vercel rejects bodies
# over 4.5 MB before they reach the app.
INGEST_MAX_BODY_KB=2048

# Keep what the agents were asked to do: your prompts, shell commands, search
# patterns and subagent tasks (trimmed, with likely secrets masked). Tool output
# and the AI's replies are never stored. Set to false to store fixed summaries
# only, such as "Bash tool started". On Vercel this text is stored in your Turso
# database, so set false if you do not want prompts in the cloud.
CAPTURE_DETAIL=true
