# Agent Observatory hub settings. Copy to .env and fill in.

# Address the API and website listen on. Default is this machine only.
# For multi-device use, set it to the hub's private address (Tailscale 100.x.y.z
# or home Wi-Fi address). Do not use 0.0.0.0.
BIND_ADDRESS=127.0.0.1

# Ports. Agents post to API_PORT. You open WEB_PORT in the browser.
API_PORT=4317
WEB_PORT=4318

# Bearer token the laptops use to send events. Never sent to the browser.
# Generate one with: openssl rand -hex 32
INGEST_TOKEN=

# Password for the dashboard and the read API (8 characters or more).
VIEWER_PASSWORD=

# SQLite file, relative to the repository root unless absolute.
DATABASE_PATH=./data/observatory.db

# Events older than this many days are deleted.
EVENT_RETENTION_DAYS=30

# Optional. Extra folders (comma separated, absolute) whose file paths may be
# stored. A session's own project folder is always allowed.
PROJECT_ROOTS=

# Optional. Largest accepted ingest request in kilobytes.
INGEST_MAX_BODY_KB=2048

# Keep what the agents were asked to do: your prompts, shell commands, search
# patterns and subagent tasks (trimmed, with likely secrets masked). Tool output
# and the AI's replies are never stored. Set to false to store fixed summaries
# only, such as "Bash tool started".
CAPTURE_DETAIL=true
