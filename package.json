{
  "name": "agent-observatory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm --filter @ao/web dev",
    "build": "pnpm --filter @ao/web build",
    "start": "pnpm --filter @ao/web start",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @ao/web lint",
    "db:generate": "pnpm --filter @ao/core db:generate",
    "simulate": "tsx scripts/simulate-events.ts",
    "db:migrate": "pnpm --filter @ao/core db:migrate"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
